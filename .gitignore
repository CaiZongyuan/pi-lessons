# Agent scratch space — local notes, never part of the published book.
.workbuddy/

# Secrets. MINERU_KEY lives here.
.env

# Build output — regenerated by `tools/book.py render`, published by CI.
/site/

# Source PDFs are deliberately not committed (licensing). Fetch them locally and point
# PI_PDF at the directory that holds them.
*.pdf
/source/

# ---------------------------------------------------------------------------
# What IS committed: books/<id>/ir/<part>.json (the translation),
#                    books/<id>/ir/<part>.meta.json, and books/<id>/ir/<part>/figures/
#
# Everything else under books/*/ir/ is scratch produced by `book.py extract`:
#   content.json  raw per-line blocks, ~12 MB for a full book, fully regenerable
#   ir.json       working copy handed to render.py
#   figures.json  crop geometry
#   meta.json     derived from book.json
#   style.css     copied from tools/pdf2html/style.css
#
# Note: ignore the scratch files by name rather than the whole <part>/ directory —
# git does not descend into an excluded directory, so excluding it would also drop the
# figure crops that live inside.
# ---------------------------------------------------------------------------
books/*/ir/*/content.json
books/*/ir/*/ir.json
books/*/ir/*/figures.json
books/*/ir/*/meta.json
books/*/ir/*/style.css
books/*/ir/*/ir.prev.json

# scratch
.scratch/
/work/
/PLAN.md

# python
__pycache__/
*.py[cod]
.venv/
venv/

# editors / os
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Astro / Starlight
docs/node_modules/
docs/dist/
docs/.astro/
docs/preview-site/
docs/prev2/
docs/prev3/
docs/dist-public-preview/
# generated from books/ by `npm run sync` — never edit
docs/src/content/docs/pi-manual/
docs/src/content/docs/pi-durable/
docs/public/_assets/
docs/public/sitemap/
docs/public/sitemap-index.xml
docs/node_modules*/
docs/pnpm-lock.yaml
docs/pnpm-workspace.yaml
docs/fix_deps.py
docs/src/components/BookCards.astro
